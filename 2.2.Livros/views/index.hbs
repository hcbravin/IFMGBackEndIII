{{> navbar }}

<div class="text-small mb-2">
    {{#if categorias_filtro}}
        <a href="/" class="btn btn-sm btn-outline-danger" style="font-size: 9pt;"><i class="bi bi-x me-1"></i> {{categorias_filtro_nome}}</a>
    {{else}}
        {{#each categorias}}
        <a href="/?categoria={{id}}&nome={{nome}}" class="btn btn-sm btn-secondary" style="font-size: 9pt;"><i class="bi bi-funnel me-1"></i> {{nome}}</a>
        {{/each}}
    {{/if}}
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Acervo</h5>
        <div class="table-responsive" style="min-height: 60vh;">
            {{#if livros}}
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th class="text-center">Categoria</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each livros}}
                    <tr>
                        <td class="align-middle">{{titulo}}</td>
                        <td class="align-middle text-center">{{categoria.nome}}</td>
                        <td class="d-flex text-center justify-content-center">
                            <a href="/livros/consulta/{{id}}" class="btn btn-sm btn-secondary align-self-center">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form method="POST"
                                action="/livros/status/{{id}}/{{#if status_btn}}emprestado{{else}}disponivel{{/if}}"
                                class="ms-1">
                                {{#if status_btn}}
                                <button type="submit" style="width: 110px;" class="btn btn-sm btn-success text-capitalize">{{status}}</button>
                                {{else}}
                                <button type="submit" style="width: 110px;" class="btn btn-sm btn-danger text-capitalize">{{status}}</button>
                                {{/if}}
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            {{else}}
            <p class="text-muted alert alert-sm alert-warning text-center">Nenhum Livro cadastrado!</p>
            {{/if}}
        </div>
    </div>
</div>