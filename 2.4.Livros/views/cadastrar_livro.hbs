{{> navbar }}
<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Novo Livro</h5>
        {{#if erros}}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {{#each erros}}
                <li>{{msg}}</li>
                {{/each}}
            </ul>
        </div>
        {{/if}}
        <form method="POST" action="/livros/cadastrar">
            <div class="mb-3 row">
                <div class="col-md-12 mb-2">
                    <label class="form-label">Título</label>
                    <input type="text" name="titulo" class="form-control" required value="{{old.titulo}}">
                </div>
                <div class="col-md-8">
                    <label class="form-label">Autor</label>
                    <input type="text" name="autor" class="form-control" required value="{{old.autor}}">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Categoria</label>
                    <select name="categoria" class="form-select" required>
                        {{#each categorias}}
                        <option value="{{id}}">{{nome}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </form>
    </div>
</div>